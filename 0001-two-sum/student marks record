n = int(input("Enter number of students: "))

marks = []

for i in range(n):
    name = input("Enter name: ")
    m = int(input("Enter marks: "))
    marks.append(m)

avg = sum(marks) / n
highest = max(marks)
lowest = min(marks)

print("Average:", avg)
print("Highest:", highest)
print("Lowest:", lowest)
