f = open("input.txt", "r")
data = f.read()

keywords = ['if', 'else', 'while', 'int', 'float', 'return']
operators = ['+', '-', '*', '/', '=', '==', '!=', '<', '>', '<=', '>=']

words = data.split()

print("Tokens:\n")

for w in words:
    if w in keywords:
        print(w, "-> Keyword")
    elif w.isdigit():
        print(w, "-> Number")
    elif w.isalnum():
        print(w, "-> Identifier")
    elif w in operators:
        print(w, "-> Operator")
    else:
        print(w, "-> Invalid")

print("\nValid Operators:")
for w in words:
    if w in operators:
        print(w)

print("\nInvalid Operators:")
for w in words:
    if any(ch in "+-*/=<>" for ch in w) and w not in operators:
        print(w)
