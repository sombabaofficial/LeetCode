import ply.lex as lex

tokens = ('ID',)

def t_ID(t):
    r'[a-zA-Z_][a-zA-Z0-9_]*'
    if len(t.value) > 10:
        print("Error: Identifier too long ->", t.value)
    else:
        return t

t_ignore = ' \t'

def t_newline(t):
    r'\n+'
    t.lexer.lineno += len(t.value)

def t_error(t):
    t.lexer.skip(1)

