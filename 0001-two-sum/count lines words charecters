f = open("input.txt", "r")
lines = f.readlines()

line_count = len(lines)
word_count = 0
char_count = 0
blank_lines = 0

for line in lines:
    char_count += len(line)
    words = line.split()
    word_count += len(words)
    
    if line.strip() == "":
        blank_lines += 1

print("Lines:", line_count)
print("Words:", word_count)
print("Characters:", char_count)
print("Blank lines:", blank_lines)
